# Interruptores de bloques (se aplican al compilar: reinicia `npm run dev` o rehaz `npm run build`).
# Se muestra un solo bloque. Si hay varios en true, gana el primero del registro (core/registry.js).
# Sin ninguna variable definida se muestra el primer bloque (la carta).
VITE_BLOCK_LETTER=true
VITE_BLOCK_GALLERY=false
VITE_BLOCK_STEAMER=false
VITE_BLOCK_ADVENT=false
